{
  "name": "thyantra-billing-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API and sync server for Thyantra Billing (web + mobile).",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "db:up": "docker compose up -d",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "test:e2e": "dotenv -e .env.test -- prisma migrate deploy && dotenv -e .env.test -- node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/static": "10.1.7",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-fastify": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "dotenv": "^16.6.1",
    "nestjs-zod": "5.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.16.5",
    "dotenv-cli": "^8.0.0",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  }
}
